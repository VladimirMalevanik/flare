# API process only. Copy to .env.yandex.api and keep it private.
# Passwords inside URLs must be percent-encoded once.
FLARE_PROCESS_ROLE=api
FLARE_DATABASE_PROVIDER=yandex
DATABASE_URL="postgresql://flare_app:<URL_ENCODED_APP_PASSWORD>@c-<CLUSTER_ID>.rw.mdb.yandexcloud.net:6432/flare?sslmode=verify-full&sslrootcert=/absolute/path/to/root.crt&target_session_attrs=read-write"

# Local application settings. For deployment, use production and an exact HTTPS origin.
FLARE_ENV=development
FLARE_DEV_MODE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_LIFETIME_SECONDS=604800
SESSION_IDLE_SECONDS=86400
