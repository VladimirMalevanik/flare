# Local development only. Do not use these passwords on a public server.
FLARE_DATABASE_PROVIDER=self-managed
POSTGRES_PASSWORD=flare_local_admin
APP_PASSWORD=flare_local_app
WORKER_PASSWORD=flare_local_worker
DATABASE_URL=postgresql://flare_app:flare_local_app@127.0.0.1:5432/flare
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:flare_local_admin@127.0.0.1:5432/flare
TEST_DATABASE_URL=postgresql://postgres:flare_local_admin@127.0.0.1:5432/flare
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
# Optional public contact address shown in Settings. Read at request time.
SUPPORT_EMAIL=

# Local auth works without a fixed development identity.
FLARE_ENV=development
FLARE_DEV_MODE=false
SESSION_LIFETIME_SECONDS=604800
SESSION_IDLE_SECONDS=86400

# Local email verification is off by default. To test it locally, set this to
# true; verification links are then printed by the backend development sender.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_TTL_SECONDS=86400
EMAIL_VERIFICATION_RESEND_SECONDS=60
APP_PUBLIC_URL=http://localhost:3000
SMTP_URL=
EMAIL_FROM=Flare <no-reply@localhost>

# GitHub App connection settings. Keep the private key in local or deployment
# secret storage; never expose it through NEXT_PUBLIC_* variables.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_FRONTEND_RETURN_URL=http://localhost:3000/sources
GITHUB_STATE_TTL_SECONDS=600

# API-only voice transcription. This can use the same Groq account as the
# worker, but keep it as a distinct deployment secret so either key can be
# rotated/revoked independently. Browser code never receives it.
VOICE_GROQ_API_KEY=
VOICE_MODEL=whisper-large-v3-turbo
VOICE_MAX_UPLOAD_BYTES=10485760
VOICE_MAX_DURATION_SECONDS=300
VOICE_UPLOAD_DEADLINE_SECONDS=15
VOICE_MEDIA_INSPECTION_TIMEOUT_SECONDS=8
VOICE_PROVIDER_DEADLINE_SECONDS=45
VOICE_MAX_TRANSCRIPT_CHARS=30000
VOICE_FFPROBE_PATH=ffprobe

# Worker-only: set a real key locally for Analyze processing. Never commit it.
# Manual or scheduled Analyze creates durable jobs; only the worker calls Groq.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
LLM_DEFAULT_MODEL=openai/gpt-oss-20b
LLM_DEFAULT_REASONING_EFFORT=low
# Serialized input safety bound, including prompt/schema; not token accounting.
LLM_MAX_INPUT_BYTES=4000
LLM_MAX_SOURCES=5
LLM_MAX_COMPLETION_TOKENS=2000
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_DEADLINE_SECONDS=40
