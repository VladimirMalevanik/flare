# Local development only. Do not use these passwords on a public server.
POSTGRES_PASSWORD=flare_local_admin
APP_PASSWORD=flare_local_app
DATABASE_URL=postgresql://flare_app:flare_local_app@127.0.0.1:5432/flare
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:flare_local_admin@127.0.0.1:5432/flare
TEST_DATABASE_URL=postgresql://postgres:flare_local_admin@127.0.0.1:5432/flare
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=/api

# Local auth works without a fixed development identity.
FLARE_ENV=development
FLARE_DEV_MODE=false
SESSION_LIFETIME_SECONDS=604800
SESSION_IDLE_SECONDS=86400
