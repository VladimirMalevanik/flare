# Initial bounded OPS-005 rollout; no credentials belong in this file.
# Preserve existing DATABASE_URL and restricted WORKER_DATABASE_URL secrets.
# Apply the same import policy to API and worker. No local production staging.
FLARE_IMPORT_ENABLED=true
FLARE_IMPORT_STORAGE_PROVIDER=postgres
FLARE_IMPORT_WORKER_CONCURRENCY=1

# Every policy field is explicit in production. Bytes use MiB where indicated.
FLARE_IMPORT_COMPRESSED_BYTES=8388608
FLARE_IMPORT_EXPANDED_BYTES=25165824
FLARE_IMPORT_ENTRIES=500
FLARE_IMPORT_DIRECTORY_BYTES=1000000
FLARE_IMPORT_MANIFEST_BYTES=2000000
FLARE_IMPORT_FILE_BYTES=200000
FLARE_IMPORT_PATH_BYTES=1024
FLARE_IMPORT_SEGMENT_BYTES=255
FLARE_IMPORT_PATH_DEPTH=32
FLARE_IMPORT_EXPANSION_RATIO=500
FLARE_IMPORT_CSV_ROWS=20000
FLARE_IMPORT_CSV_FIELD_BYTES=100000
FLARE_IMPORT_CSV_ROW_BYTES=200000
FLARE_IMPORT_CHUNKS_FILE=2000
FLARE_IMPORT_CHUNKS_PACKAGE=10000
FLARE_IMPORT_CHUNK_BYTES=4000
FLARE_IMPORT_UPLOAD_SECONDS=120
FLARE_IMPORT_INSPECT_SECONDS=15
FLARE_IMPORT_FILE_SECONDS=15
FLARE_IMPORT_JOB_SECONDS=180
FLARE_IMPORT_CPU_SECONDS=60
FLARE_IMPORT_MEMORY_BYTES=268435456
FLARE_IMPORT_SCRATCH_BYTES=67108864
FLARE_IMPORT_STAGED_QUOTA_BYTES=16777216
FLARE_IMPORT_SOURCE_QUOTA_BYTES=67108864
FLARE_IMPORT_WORKSPACE_CONCURRENCY=1
FLARE_IMPORT_GLOBAL_CONCURRENCY=1
FLARE_IMPORT_ATTEMPTS=3
FLARE_IMPORT_LEASE_SECONDS=60
FLARE_IMPORT_BACKOFF_SECONDS=5
FLARE_IMPORT_STAGING_SECONDS=3600
FLARE_IMPORT_CLEANUP_SECONDS=3600
FLARE_IMPORT_REPORT_PAGE=100

# bootstrap_flare_worker.sh creates a private directory and exports its path.
# readiness needs successful jobs DB polls <=240s and cleanup DB polls <=30s.
# This proves consumer availability, not import completion or backup erasure.
