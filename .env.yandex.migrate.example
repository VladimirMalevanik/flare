# Yandex migration process only. Copy to .env.yandex.migrate and keep it private.
# Passwords inside URLs must be percent-encoded once.
FLARE_PROCESS_ROLE=migration
FLARE_DATABASE_PROVIDER=yandex
MIGRATION_DATABASE_URL="postgresql+psycopg://flare_owner:<URL_ENCODED_OWNER_PASSWORD>@c-<CLUSTER_ID>.rw.mdb.yandexcloud.net:6432/flare?sslmode=verify-full&sslrootcert=/absolute/path/to/root.crt&target_session_attrs=read-write"
