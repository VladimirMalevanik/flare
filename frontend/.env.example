NEXT_PUBLIC_API_URL=/api
# Use "mock" for the standalone browser demo.
NEXT_PUBLIC_DATA_PROVIDER=api

# Must be set at both build and runtime when the backend address changes.
API_INTERNAL_URL=http://127.0.0.1:8000

# Optional public contact address, read by the server at request time.
# Leave empty until the production support address is approved.
SUPPORT_EMAIL=

# Paddle Billing SANDBOX only. Public client-side token (starts with test_).
# Set these in frontend/.env.local for development, and during a production build.
# No Paddle API key or webhook secret is needed for this checkout-only stage.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRO_PRICE_ID=pri_01m3y1nvmgw2avt60bz87161c2
