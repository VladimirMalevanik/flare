# Analysis worker process only. Copy to .env.yandex.worker and keep it private.
# Passwords inside URLs must be percent-encoded once.
FLARE_PROCESS_ROLE=worker
FLARE_DATABASE_PROVIDER=yandex
WORKER_DATABASE_URL="postgresql://flare_worker:<URL_ENCODED_WORKER_PASSWORD>@c-<CLUSTER_ID>.rw.mdb.yandexcloud.net:6432/flare?sslmode=verify-full&sslrootcert=/absolute/path/to/root.crt&target_session_attrs=read-write"

# Reuse the same approved sender and public app origin as email verification.
APP_PUBLIC_URL=http://localhost:3000
SMTP_URL=
EMAIL_FROM=Flare <no-reply@localhost>

# Backend-only AI analysis settings. GROQ_API_KEY is required to start worker.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
LLM_DEFAULT_MODEL=openai/gpt-oss-20b
LLM_DEFAULT_REASONING_EFFORT=low
LLM_MAX_INPUT_BYTES=4000
LLM_MAX_SOURCES=5
LLM_MAX_COMPLETION_TOKENS=2000
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_DEADLINE_SECONDS=40
